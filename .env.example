# Application Configuration Example (.env)
# Copy this file to .env for local development overrides.

ENVIRONMENT=development
APP_NAME=email-discovery-api
DEBUG=false
LOG_LEVEL=INFO

# PostgreSQL Async Database Connection
DATABASE_URL=postgresql+asyncpg://postgres:postgres@localhost:5432/email_discovery
DB_POOL_SIZE=10
DB_MAX_OVERFLOW=20
DB_POOL_TIMEOUT=30.0
DB_POOL_RECYCLE=1800
DB_HEALTH_TIMEOUT_SECONDS=2.0

# Redis Coordination Settings
# Unauthenticated localhost Redis is for local development only.
# Production environments require private networking and authenticated redis:// or rediss:// configuration.
REDIS_URL=redis://localhost:6379/0
REDIS_REQUIRED=false
REDIS_MAX_CONNECTIONS=20
REDIS_CONNECT_TIMEOUT=2.0
REDIS_SOCKET_TIMEOUT=2.0
REDIS_OPERATION_TIMEOUT=0.5
REDIS_PUBLISH_TIMEOUT=0.25
REDIS_HEALTH_TIMEOUT=1.0
REDIS_KEY_PREFIX=email_discovery:v1:dev
REDIS_RATE_LIMIT_FALLBACK_MODE=strict_pause
REDIS_MIN_DOMAIN_INTERVAL_MS=1000
REDIS_MAX_RESERVATION_HORIZON_MS=60000
REDIS_MIN_TTL_MS=60000
REDIS_MAX_TTL_MS=86400000
REDIS_SAFETY_MARGIN_MS=5000
