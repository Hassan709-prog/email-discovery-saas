FROM python:3.14-slim

WORKDIR /app

# Install system dependencies
RUN apt-get update && apt-get install -y --no-install-recommends \
    build-essential \
    curl \
    && rm -rf /var/lib/apt-get/lists/*

# Copy uv dependency files
COPY pyproject.toml uv.lock ./
COPY packages/scanner/pyproject.toml packages/scanner/
COPY apps/api/pyproject.toml apps/api/
COPY workers/crawl/pyproject.toml workers/crawl/

# Copy source code
COPY packages/scanner packages/scanner
COPY apps/api apps/api
COPY workers/crawl workers/crawl

# Install uv and dependencies
RUN pip install --no-cache-dir uv && \
    uv pip install --system -e packages/scanner -e apps/api -e workers/crawl

# Environment defaults
ENV PYTHONUNBUFFERED=1

CMD ["python", "-m", "email_discovery_crawl_worker.cli"]
